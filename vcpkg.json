{
  "name": "autoslides-extractor",
  "version": "2.1.0",
  "description": "AutoSlides Extractor - Extract slides from video presentations using advanced image processing",
  "homepage": "https://github.com/bit-admin/AutoSlides-Extractor",
  "dependencies": [
    {
      "name": "opencv4",
      "default-features": false,
      "features": [
        "jpeg",
        "png"
      ]
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "gpl",
        "opus",
        "swresample",
        "swscale",
        "version3",
        "x264"
      ]
    }
  ]
}
